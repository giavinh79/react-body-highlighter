{
  "name": "react-body-highlighter",
  "version": "2.0.5",
  "description": "React.js component for highlighting muscles on a body model",
  "keywords": [
    "body",
    "color",
    "exercise",
    "fitness",
    "highlight",
    "highlighter",
    "model",
    "muscle",
    "muscles",
    "react",
    "svg",
    "workout"
  ],
  "homepage": "https://github.com/giavinh79/react-body-highlighter",
  "license": "MIT",
  "author": "giavinh79",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giavinh79/react-body-highlighter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "storybook dev -p 6006",
    "analyze": "RSDOCTOR=true rslib build",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:pkg": "publint --strict && pnpm pack --out .pack/pkg.tgz && attw .pack/pkg.tgz",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm build && pnpm check:pkg",
    "build:storybook": "storybook build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@github-ui/storybook-addon-performance-panel": "^1.2.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@rsbuild/core": "^2.2.1",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsdoctor/rspack-plugin": "^1.6.3",
    "@rslib/core": "1.0.0",
    "@rstest/core": "0.11.10",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/icons": "^2.1.0",
    "@storybook/react": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "happy-dom": "^20.11.15",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "storybook-react-rsbuild": "^3.4.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.1"
}
